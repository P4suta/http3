    "gleam.toml",
    "manifest.toml",
    "mix.exs",
    "mix.lock",
    "packages/http3/gleam.toml",
    "packages/http3/manifest.toml",
    "packages/http3/mix.exs",
    "packages/http3/mix.lock",
    "packages/quic_core/gleam.toml",
    "packages/quic_core/manifest.toml",
    "packages/quic_core/mix.exs",
    "scripts/coverage.escript",
    "scripts/fresh_build.sh"
  ],
  "source_trees": [
    "src",
    "test",
    "packages/http3/src",
    "packages/http3/test",
    "packages/quic_core/src",
    "packages/quic_core/test"
  ]
}
