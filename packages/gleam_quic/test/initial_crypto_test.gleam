// nolint: unused_exports -- gleeunit discovers public test functions by suffix.
pub fn encodes_rfc9001_hkdf_labels_test() -> Nil {
  assert initial_crypto.hkdf_label(<<"client in":utf8>>, <<>>, 32)
    == Ok(<<
      0x00,
      0x20,
      0x0f,
      0x74,
      0x6c,
      0x73,
      0x31,
      0x33,
      0x20,
      0x63,
      0x6c,
      0x69,
      0x65,
      0x6e,
      0x74,
      0x20,
      0x69,
      0x6e,
      0x00,
    >>)
  assert initial_crypto.hkdf_label(<<"quicv2 key":utf8>>, <<>>, 16)
    == Ok(<<
      0x00,
      0x10,
      0x10,
      0x74,
      0x6c,
      0x73,
      0x31,
      0x33,
      0x20,
      0x71,
      0x75,
      0x69,
      0x63,
      0x76,
      0x32,
      0x20,
      0x6b,
      0x65,
      0x79,
      0x00,
    >>)
}

