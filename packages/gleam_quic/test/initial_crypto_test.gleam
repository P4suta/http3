// nolint: unused_exports -- gleeunit discovers public test functions by suffix.
pub fn rejects_invalid_initial_crypto_inputs_test() -> Nil {
  let unaligned = <<1:size(1)>>
  assert initial_crypto.hkdf_label(<<>>, <<>>, 16)
    == Error(initial_crypto.InvalidInput)
  assert initial_crypto.hkdf_label(<<"key":utf8>>, unaligned, 16)
    == Error(initial_crypto.NonByteAligned)
  assert initial_crypto.hkdf_label(<<"key":utf8>>, <<>>, -1)
    == Error(initial_crypto.InvalidInput)
  assert initial_crypto.hkdf_label(<<"key":utf8>>, <<>>, 65_536)
    == Error(initial_crypto.InvalidInput)
  assert initial_crypto.derive_initial(version.Negotiation, <<>>)
    == Error(initial_crypto.UnsupportedVersion(version.Negotiation))
  assert initial_crypto.derive_initial(version.Unknown(0x0a0a_0a0a), <<>>)
    == Error(initial_crypto.UnsupportedVersion(version.Unknown(0x0a0a_0a0a)))
  assert initial_crypto.derive_initial(version.Version1, unaligned)
    == Error(initial_crypto.NonByteAligned)
  assert initial_crypto.derive_initial(version.Version1, <<0:168>>)
    == Error(initial_crypto.InvalidInput)

  let assert Ok(keys) =
    initial_crypto.derive_initial(version.Version1, destination_connection_id)
  assert initial_crypto.header_protection_mask(keys.client, <<0:120>>)
    == Error(initial_crypto.InvalidInput)
  assert initial_crypto.header_protection_mask(keys.client, unaligned)
    == Error(initial_crypto.NonByteAligned)
}
