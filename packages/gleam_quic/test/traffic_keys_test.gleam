import gleam/bit_array
import gleam_quic/internal/crypto
import gleam_quic/internal/tls/hello
import gleam_quic/internal/traffic_keys
import gleam_quic/version

// nolint: unused_exports -- gleeunit discovers public test functions by suffix.
pub fn matches_rfc9001_chacha20_short_packet_test() -> Nil {
  let secret = <<
    0x9a, 0xc3, 0x12, 0xa7, 0xf8, 0x77, 0x46, 0x8e, 0xbe, 0x69, 0x42, 0x27, 0x48,
    0xad, 0x00, 0xa1, 0x54, 0x43, 0xf1, 0x82, 0x03, 0xa0, 0x7d, 0x60, 0x60, 0xf6,
    0x88, 0xf3, 0x0f, 0x21, 0x63, 0x2b,
  >>
  let assert Ok(keys) =
    traffic_keys.from_secret(
      version.Version1,
      hello.Chacha20Poly1305Sha256,
      secret,
    )
  assert keys.key
    == <<
      0xc6, 0xd9, 0x8f, 0xf3, 0x44, 0x1c, 0x3f, 0xe1, 0xb2, 0x18, 0x20, 0x94,
      0xf6, 0x9c, 0xaa, 0x2e, 0xd4, 0xb7, 0x16, 0xb6, 0x54, 0x88, 0x96, 0x0a,
      0x7a, 0x98, 0x49, 0x79, 0xfb, 0x23, 0xe1, 0xc8,
    >>
  assert keys.iv
    == <<
      0xe0, 0x45, 0x9b, 0x34, 0x74, 0xbd, 0xd0, 0xe4, 0x4a, 0x41, 0xc1, 0x44,
    >>
  assert traffic_keys.next_secret(keys)
    == Ok(<<
      0x12, 0x23, 0x50, 0x47, 0x55, 0x03, 0x6d, 0x55, 0x63, 0x42, 0xee, 0x93,
      0x61, 0xd2, 0x53, 0x42, 0x1a, 0x82, 0x6c, 0x9e, 0xcd, 0xf3, 0xc7, 0x14,
      0x86, 0x84, 0xb3, 0x6b, 0x71, 0x48, 0x81, 0xf9,
    >>)

  let header = <<0x42, 0x00, 0xbf, 0xf4>>
  let assert Ok(ciphertext) =
    traffic_keys.protect(keys, 654_360_564, header, <<1>>)
  assert ciphertext
    == <<
      0x65, 0x5e, 0x5c, 0xd5, 0x5c, 0x41, 0xf6, 0x90, 0x80, 0x57, 0x5d, 0x79,
      0x99, 0xc2, 0x5a, 0x5b, 0xfb,
    >>
  assert traffic_keys.unprotect(keys, 654_360_564, header, ciphertext)
    == Ok(<<1>>)
  assert traffic_keys.header_protection_mask(keys, <<
      0x5e, 0x5c, 0xd5, 0x5c, 0x41, 0xf6, 0x90, 0x80, 0x57, 0x5d, 0x79, 0x99,
      0xc2, 0x5a, 0x5b, 0xfb,
    >>)
    == Ok(<<0xae, 0xfe, 0xfe, 0x7d, 0x03>>)
}

// nolint: unused_exports -- gleeunit discovers public test functions by suffix.
pub fn supports_sha384_traffic_secrets_and_rejects_ccm_test() -> Nil {
  let assert Ok(keys) =
    traffic_keys.from_secret(version.Version2, hello.Aes256GcmSha384, <<0:384>>)
  assert crypto.hash_length(keys.hash_algorithm) == 48
  assert bit_array.byte_size(keys.key) == 32
  assert bit_array.byte_size(keys.iv) == 12
  assert bit_array.byte_size(keys.header_protection_key) == 32
  assert traffic_keys.from_secret(version.Version1, hello.Aes128CcmSha256, <<
      0:256,
    >>)
    == Error(traffic_keys.UnsupportedCipherSuite(hello.Aes128CcmSha256))
}
