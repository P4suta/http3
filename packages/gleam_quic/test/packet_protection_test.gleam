// nolint: unused_exports -- gleeunit discovers public test functions by suffix.
pub fn protects_rfc9369_server_initial_payload_test() -> Nil {
  let assert Ok(initial) =
    initial_crypto.derive_initial(version.Version2, destination_connection_id)

  assert packet_protection.nonce(initial.server.iv, 1)
    == Ok(<<
      0xdd,
      0x13,
      0xc2,
      0x76,
      0x49,
      0x9c,
      0x02,
      0x49,
      0xd3,
      0x31,
      0x06,
      0x53,
    >>)

  let plaintext = <<
    0x02, 0x00, 0x00, 0x00, 0x00, 0x06, 0x00, 0x40, 0x5a, 0x02, 0x00, 0x00, 0x56,
    0x03, 0x03, 0xee, 0xfc, 0xe7, 0xf7, 0xb3, 0x7b, 0xa1, 0xd1, 0x63, 0x2e, 0x96,
    0x67, 0x78, 0x25, 0xdd, 0xf7, 0x39, 0x88, 0xcf, 0xc7, 0x98, 0x25, 0xdf, 0x56,
    0x6d, 0xc5, 0x43, 0x0b, 0x9a, 0x04, 0x5a, 0x12, 0x00, 0x13, 0x01, 0x00, 0x00,
    0x2e, 0x00, 0x33, 0x00, 0x24, 0x00, 0x1d, 0x00, 0x20, 0x9d, 0x3c, 0x94, 0x0d,
    0x89, 0x69, 0x0b, 0x84, 0xd0, 0x8a, 0x60, 0x99, 0x3c, 0x14, 0x4e, 0xca, 0x68,
    0x4d, 0x10, 0x81, 0x28, 0x7c, 0x83, 0x4d, 0x53, 0x11, 0xbc, 0xf3, 0x2b, 0xb9,
    0xda, 0x1a, 0x00, 0x2b, 0x00, 0x02, 0x03, 0x04,
  >>
  let ciphertext = <<
    0xaa, 0xf1, 0x6f, 0x05, 0xd8, 0xa4, 0x39, 0x8c, 0x47, 0x08, 0x96, 0x98, 0xba,
    0xee, 0xa2, 0x6b, 0x91, 0xeb, 0x76, 0x1d, 0x9b, 0x89, 0x23, 0x7b, 0xbf, 0x87,
    0x26, 0x30, 0x17, 0x91, 0x53, 0x58, 0x23, 0x00, 0x35, 0xf7, 0xfd, 0x39, 0x45,
    0xd8, 0x89, 0x65, 0xcf, 0x17, 0xf9, 0xaf, 0x6e, 0x16, 0x88, 0x6c, 0x61, 0xbf,
    0xc7, 0x03, 0x10, 0x6f, 0xba, 0xf3, 0xcb, 0x4c, 0xfa, 0x52, 0x38, 0x2d, 0xd1,
    0x6a, 0x39, 0x3e, 0x42, 0x75, 0x75, 0x07, 0x69, 0x80, 0x75, 0xb2, 0xc9, 0x84,
    0xc7, 0x07, 0xf0, 0xa0, 0x81, 0x2d, 0x8c, 0xd5, 0xa6, 0x88, 0x1e, 0xaf, 0x21,
    0xce, 0xda, 0x98, 0xf4, 0xbd, 0x23, 0xf6, 0xfe, 0x1a, 0x3e, 0x2c, 0x43, 0xed,
    0xd9, 0xce, 0x7c, 0xa8, 0x4b, 0xed, 0x85, 0x21, 0xe2, 0xe1, 0x40,
  >>

  assert packet_protection.protect_payload(
      initial.server,
      1,
      server_header,
      plaintext,
    )
    == Ok(ciphertext)
  assert packet_protection.unprotect_payload(
      initial.server,
      1,
      server_header,
      ciphertext,
    )
    == Ok(plaintext)

  let assert <<first, rest:bits>> = ciphertext
  let tampered = <<int.bitwise_exclusive_or(first, 1), rest:bits>>
  assert packet_protection.unprotect_payload(
      initial.server,
      1,
      server_header,
      tampered,
    )
    == Error(packet_protection.AuthenticationFailed)
}

// nolint: unused_exports -- gleeunit discovers public test functions by suffix.
pub fn rejects_invalid_packet_protection_inputs_test() -> Nil {
  let assert Ok(initial) =
    initial_crypto.derive_initial(version.Version1, destination_connection_id)
  let unaligned = <<1:size(1)>>

  assert packet_protection.nonce(initial.client.iv, -1)
    == Error(packet_protection.InvalidInput)
  assert packet_protection.nonce(initial.client.iv, 4_611_686_018_427_387_904)
    == Error(packet_protection.InvalidInput)
  assert packet_protection.nonce(unaligned, 0)
    == Error(packet_protection.NonByteAligned)
  assert packet_protection.protect_payload(initial.client, 0, unaligned, <<>>)
    == Error(packet_protection.NonByteAligned)
  assert packet_protection.unprotect_payload(initial.client, 0, <<>>, <<
      1,
      2,
      3,
    >>)
    == Error(packet_protection.InvalidInput)
}

// nolint: unused_exports -- gleeunit discovers public test functions by suffix.
pub fn applies_and_removes_rfc9369_initial_header_protection_test() -> Nil {
  let protected_prefix = <<
    0xd7, 0x6b, 0x33, 0x43, 0xcf, 0x08, 0x83, 0x94, 0xc8, 0xf0, 0x3e, 0x51, 0x57,
    0x08, 0x00, 0x00, 0x44, 0x9e, 0xa0, 0xc9, 0x5e, 0x82, 0xff, 0xe6, 0x7b, 0x6a,
    0xbc, 0xdb, 0x42, 0x98, 0xb4, 0x85, 0xdd, 0x04, 0xde, 0x80, 0x60, 0x71,
  >>
  let sample = <<
    0xff, 0xe6, 0x7b, 0x6a, 0xbc, 0xdb, 0x42, 0x98, 0xb4, 0x85, 0xdd, 0x04, 0xde,
    0x80, 0x60, 0x71,
  >>
  let mask = <<0x94, 0xa0, 0xc9, 0x5e, 0x80>>

  assert packet_protection.header_protection_sample(protected_prefix, 18)
    == Ok(sample)
  assert packet_protection.protect_header(
      packet_protection.Long,
      0xd3,
      <<0x00, 0x00, 0x00, 0x02>>,
      mask,
    )
    == Ok(#(0xd7, <<0xa0, 0xc9, 0x5e, 0x82>>))
  assert packet_protection.unprotect_header(
      packet_protection.Long,
      0xd7,
      <<0xa0, 0xc9, 0x5e, 0x82, sample:bits>>,
      mask,
    )
    == Ok(packet_protection.UnprotectedHeader(
      0xd3,
      <<0x00, 0x00, 0x00, 0x02>>,
      sample,
    ))
}

// nolint: unused_exports -- gleeunit discovers public test functions by suffix.
pub fn rejects_invalid_header_protection_inputs_test() -> Nil {
  let unaligned = <<1:size(1)>>
  let mask = <<0, 0, 0, 0, 0>>
  assert packet_protection.header_protection_sample(unaligned, 0)
    == Error(packet_protection.NonByteAligned)
  assert packet_protection.header_protection_sample(<<0:160>>, -1)
    == Error(packet_protection.InvalidInput)
  assert packet_protection.header_protection_sample(<<0:152>>, 0)
    == Error(packet_protection.InvalidInput)
  assert packet_protection.protect_header(
      packet_protection.Short,
      0x40,
      <<>>,
      mask,
    )
    == Error(packet_protection.InvalidInput)
  assert packet_protection.protect_header(packet_protection.Long, 0xc0, <<0>>, <<
      0,
      0,
      0,
      0,
    >>)
    == Error(packet_protection.InvalidInput)
  assert packet_protection.unprotect_header(
      packet_protection.Long,
      0xc3,
      <<0, 0>>,
      mask,
    )
    == Error(packet_protection.InvalidInput)
}
