// nolint: unused_exports -- gleeunit discovers public test functions by suffix.
pub fn matches_rfc8448_handshake_key_schedule_test() -> Nil {
  let shared_secret = <<
    0x8b, 0xd4, 0x05, 0x4f, 0xb5, 0x5b, 0x9d, 0x63, 0xfd, 0xfb, 0xac, 0xf9, 0xf0,
    0x4b, 0x9f, 0x0d, 0x35, 0xe6, 0xd6, 0x3f, 0x53, 0x75, 0x63, 0xef, 0xd4, 0x62,
    0x72, 0x90, 0x0f, 0x89, 0x49, 0x2d,
  >>
  let hello_transcript_hash = <<
    0x86, 0x0c, 0x06, 0xed, 0xc0, 0x78, 0x58, 0xee, 0x8e, 0x78, 0xf0, 0xe7, 0x42,
    0x8c, 0x58, 0xed, 0xd6, 0xb4, 0x3f, 0x2c, 0xa3, 0xe6, 0xe9, 0x5f, 0x02, 0xed,
    0x06, 0x3c, 0xf0, 0xe1, 0xca, 0xd8,
  >>

  let assert Ok(secrets) =
    key_schedule.derive_handshake_secrets(
      crypto.Sha256,
      None,
      shared_secret,
      hello_transcript_hash,
    )
  let key_schedule.HandshakeSecrets(
    early_secret: early_secret,
    handshake_secret: handshake_secret,
    client_handshake_traffic_secret: client_handshake,
    server_handshake_traffic_secret: server_handshake,
    master_secret: master_secret,
  ) = secrets

  assert early_secret
    == <<
      0x33, 0xad, 0x0a, 0x1c, 0x60, 0x7e, 0xc0, 0x3b, 0x09, 0xe6, 0xcd, 0x98,
      0x93, 0x68, 0x0c, 0xe2, 0x10, 0xad, 0xf3, 0x00, 0xaa, 0x1f, 0x26, 0x60,
      0xe1, 0xb2, 0x2e, 0x10, 0xf1, 0x70, 0xf9, 0x2a,
    >>
  assert handshake_secret
    == <<
      0x1d, 0xc8, 0x26, 0xe9, 0x36, 0x06, 0xaa, 0x6f, 0xdc, 0x0a, 0xad, 0xc1,
      0x2f, 0x74, 0x1b, 0x01, 0x04, 0x6a, 0xa6, 0xb9, 0x9f, 0x69, 0x1e, 0xd2,
      0x21, 0xa9, 0xf0, 0xca, 0x04, 0x3f, 0xbe, 0xac,
    >>
  assert client_handshake
    == <<
      0xb3, 0xed, 0xdb, 0x12, 0x6e, 0x06, 0x7f, 0x35, 0xa7, 0x80, 0xb3, 0xab,
      0xf4, 0x5e, 0x2d, 0x8f, 0x3b, 0x1a, 0x95, 0x07, 0x38, 0xf5, 0x2e, 0x96,
      0x00, 0x74, 0x6a, 0x0e, 0x27, 0xa5, 0x5a, 0x21,
    >>
  assert server_handshake
    == <<
      0xb6, 0x7b, 0x7d, 0x69, 0x0c, 0xc1, 0x6c, 0x4e, 0x75, 0xe5, 0x42, 0x13,
      0xcb, 0x2d, 0x37, 0xb4, 0xe9, 0xc9, 0x12, 0xbc, 0xde, 0xd9, 0x10, 0x5d,
      0x42, 0xbe, 0xfd, 0x59, 0xd3, 0x91, 0xad, 0x38,
    >>
  assert master_secret
    == <<
      0x18, 0xdf, 0x06, 0x84, 0x3d, 0x13, 0xa0, 0x8b, 0xf2, 0xa4, 0x49, 0x84,
      0x4c, 0x5f, 0x8a, 0x47, 0x80, 0x01, 0xbc, 0x4d, 0x4c, 0x62, 0x79, 0x84,
      0xd5, 0xa4, 0x1d, 0xa8, 0xd0, 0x40, 0x29, 0x19,
    >>
}

// nolint: unused_exports -- gleeunit discovers public test functions by suffix.
pub fn rejects_malformed_key_schedule_inputs_test() -> Nil {
  assert key_schedule.expand_label(crypto.Sha256, <<0:256>>, <<>>, <<>>, 32)
    == Error(crypto.InvalidInput)
  assert key_schedule.expand_label(
      crypto.Sha256,
      <<0:256>>,
      <<"label">>,
      <<1:size(1)>>,
      32,
    )
    == Error(crypto.NonByteAligned)
  assert key_schedule.derive_handshake_secrets(crypto.Sha256, None, <<0:256>>, <<
      0:248,
    >>)
    == Error(crypto.InvalidInput)
}

