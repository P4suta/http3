// nolint: unused_exports -- gleeunit discovers public test functions by suffix.
pub fn matches_rfc5869_sha256_test_case_one_test() -> Nil {
  let input_key_material = <<
    0x0b,
    0x0b,
    0x0b,
    0x0b,
    0x0b,
    0x0b,
    0x0b,
    0x0b,
    0x0b,
    0x0b,
    0x0b,
    0x0b,
    0x0b,
    0x0b,
    0x0b,
    0x0b,
    0x0b,
    0x0b,
    0x0b,
    0x0b,
    0x0b,
    0x0b,
  >>
  let salt = <<
    0x00,
    0x01,
    0x02,
    0x03,
    0x04,
    0x05,
    0x06,
    0x07,
    0x08,
    0x09,
    0x0a,
    0x0b,
    0x0c,
  >>
  let info = <<0xf0, 0xf1, 0xf2, 0xf3, 0xf4, 0xf5, 0xf6, 0xf7, 0xf8, 0xf9>>
  let pseudorandom_key = <<
    0x07, 0x77, 0x09, 0x36, 0x2c, 0x2e, 0x32, 0xdf, 0x0d, 0xdc, 0x3f, 0x0d, 0xc4,
    0x7b, 0xba, 0x63, 0x90, 0xb6, 0xc7, 0x3b, 0xb5, 0x0f, 0x9c, 0x31, 0x22, 0xec,
    0x84, 0x4a, 0xd7, 0xc2, 0xb3, 0xe5,
  >>
  let output_key_material = <<
    0x3c, 0xb2, 0x5f, 0x25, 0xfa, 0xac, 0xd5, 0x7a, 0x90, 0x43, 0x4f, 0x64, 0xd0,
    0x36, 0x2f, 0x2a, 0x2d, 0x2d, 0x0a, 0x90, 0xcf, 0x1a, 0x5a, 0x4c, 0x5d, 0xb0,
    0x2d, 0x56, 0xec, 0xc4, 0xc5, 0xbf, 0x34, 0x00, 0x72, 0x08, 0xd5, 0xb8, 0x87,
    0x18, 0x58, 0x65,
  >>

  assert crypto.hkdf_extract_sha256(salt, input_key_material)
    == Ok(pseudorandom_key)
  assert crypto.hkdf_expand_sha256(pseudorandom_key, info, 42)
    == Ok(output_key_material)
}

// nolint: unused_exports -- gleeunit discovers public test functions by suffix.
pub fn rejects_invalid_hkdf_inputs_test() -> Nil {
  let unaligned = <<1:size(1)>>
  let pseudorandom_key = <<0:256>>
  assert crypto.hkdf_extract_sha256(unaligned, <<>>)
    == Error(crypto.NonByteAligned)
  assert crypto.hkdf_expand_sha256(unaligned, <<>>, 32)
    == Error(crypto.NonByteAligned)
  assert crypto.hkdf_expand_sha256(<<0:248>>, <<>>, 32)
    == Error(crypto.InvalidInput)
  assert crypto.hkdf_expand_sha256(pseudorandom_key, <<>>, -1)
    == Error(crypto.InvalidInput)
  assert crypto.hkdf_expand_sha256(pseudorandom_key, <<>>, 8161)
    == Error(crypto.OutputTooLong)
}
