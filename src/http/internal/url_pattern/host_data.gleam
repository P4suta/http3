/// 0 valid/deviation, 1 ignored, 2 mapped, 3 disallowed (nontransitional).
pub fn mapping(code: Int) -> #(Int, List(Int)) {
  mapping_at(code: code, low: 0, high: 9185)
}

fn mapping_at(
  code code: Int,
  low low: Int,
  high high: Int,
) -> #(Int, List(Int)) {
  use <- bool.guard(low >= high, #(3, []))
  let middle = low + { high - low } / 2
  let skipped = middle * 112
  case mappings {
    <<_:size(skipped), first:32, last:32, status:8, offset:32, count:8, _:bits>> ->
      case code {
        value if value < first -> mapping_at(code: code, low: low, high: middle)
        value if value > last ->
          mapping_at(code: code, low: middle + 1, high: high)
        _ -> #(status, codes(data: mapping_data, offset: offset, count: count))
      }
    _ -> #(3, [])
  }
}

pub fn decomposition(code: Int) -> List(Int) {
  decomposition_at(code: code, low: 0, high: 2081)
}

fn decomposition_at(code code: Int, low low: Int, high high: Int) -> List(Int) {
  use <- bool.guard(low >= high, [code])
  let middle = low + { high - low } / 2
  let skipped = middle * 72
  case decompositions {
    <<_:size(skipped), point:32, offset:32, count:8, _:bits>> ->
      case code {
        value if value < point ->
          decomposition_at(code: code, low: low, high: middle)
        value if value > point ->
          decomposition_at(code: code, low: middle + 1, high: high)
        _ -> codes(data: decomposition_data, offset: offset, count: count)
      }
    _ -> [code]
  }
}

/// Missing canonical composition is -1; callers handle Hangul algorithmically.
pub fn composition(first first: Int, second second: Int) -> Int {
  composition_at(key: first * 1_114_112 + second, low: 0, high: 961)
}

fn composition_at(key key: Int, low low: Int, high high: Int) -> Int {
  use <- bool.guard(low >= high, -1)
  let middle = low + { high - low } / 2
  let skipped = middle * 96
  case compositions {
    <<_:size(skipped), found:64, composed:32, _:bits>> ->
      case key {
        value if value < found ->
          composition_at(key: key, low: low, high: middle)
        value if value > found ->
          composition_at(key: key, low: middle + 1, high: high)
        _ -> composed
      }
    _ -> -1
  }
}

fn codes(
  data data: BitArray,
  offset offset: Int,
  count count: Int,
) -> List(Int) {
  let skipped = offset * 32
  let length = count * 32
  case data {
    <<_:size(skipped), values:size(length)-bits, _:bits>> ->
      read_codes(data: values, reversed: [])
    _ -> []
  }
}

fn read_codes(data data: BitArray, reversed reversed: List(Int)) -> List(Int) {
  case data {
    <<code:32, rest:bits>> ->
      read_codes(data: rest, reversed: [code, ..reversed])
    _ -> list.reverse(reversed)
  }
}

pub fn ccc(code: Int) -> Int {
  property(data: classes, code: code, low: 0, high: 393, default: 0)
}

pub fn mark(code: Int) -> Int {
  property(data: marks, code: code, low: 0, high: 321, default: 0)
}

pub fn bidi(code: Int) -> Int {
  property(data: bidis, code: code, low: 0, high: 1572, default: 0)
}

pub fn joining(code: Int) -> Int {
  property(data: joiners, code: code, low: 0, high: 519, default: 0)
}

fn property(
  data data: BitArray,
  code code: Int,
  low low: Int,
  high high: Int,
  default default: Int,
) -> Int {
  use <- bool.guard(low >= high, default)
  let middle = low + { high - low } / 2
  let skipped = middle * 80
  case data {
    <<_:size(skipped), first:32, last:32, value:16, _:bits>> ->
      case code {
        point if point < first ->
          property(
            data: data,
            code: code,
            low: low,
            high: middle,
            default: default,
          )
        point if point > last ->
          property(
            data: data,
            code: code,
            low: middle + 1,
            high: high,
            default: default,
          )
        _ -> value
      }
    _ -> default
  }
}
