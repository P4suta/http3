pub fn id_start(code: Int) -> Bool {
  contains(ranges: starts, code:, low: 0, high: 677)
}

pub fn id_continue(code: Int) -> Bool {
  contains(ranges: continues, code:, low: 0, high: 793)
}

fn contains(
  ranges ranges: BitArray,
  code code: Int,
  low low: Int,
  high high: Int,
) -> Bool {
  use <- bool.guard(low >= high, False)
  let middle = low + { high - low } / 2
  let skipped = middle * 64
  case ranges {
    <<_:size(skipped), first:32, last:32, _:bits>> ->
      case code {
        value if value < first -> contains(ranges:, code:, low:, high: middle)
        value if value > last -> contains(ranges:, code:, low: middle + 1, high:)
        _ -> True
      }
    _ -> False
  }
}
