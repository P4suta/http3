{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>P4suta/renovate-config"],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/build/**",
    "**/deps/**",
    "**/fixtures/**",
    "**/__fixtures__/**",
    "**/examples/**"
  ],
  "pip-compile": {
    "managerFilePatterns": ["/^packages/http3/test/interop/requirements\\.txt$/"]
  },
  "pip_requirements": {"enabled": false}
}
