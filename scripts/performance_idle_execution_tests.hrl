idw_execution_self_test() ->
    Nonce = binary:copy(<<"A">>, 32), Digest = binary:copy(<<"B">>, 64),
    Identity = #{<<"schema">> => 2, <<"source_sha256">> => Digest, <<"files">> => 1},
    Runtime = execution_runtime(), Build = #{<<"toolchain">> => #{<<"runtime">> => Runtime}},
    Metadata = runtime_matrix_json(#{schema => 1,
        method => <<"verified_select_ast_scalar_wrapper">>, original_beam_sha256 => Digest,
        instrumented_beam_sha256 => Digest, select_ast_sha256 => Digest,
        receive_expression_unchanged => true, payloads_observed => false, added_timers => 0}),
    Fixture = idw_fixture_test_value(),
    Child = runtime_matrix_json(#{schema => 2, nonce => Nonce, status => <<"Passed">>,
        failure => null, fixture => Fixture, instrumentation => Metadata,
        diagnostics => #{schema => 1, phase => 14, elapsed_milliseconds => 4000,
            phases => [#{phase => P, elapsed_milliseconds => 0} || P <- lists:seq(0, 14)],
            quiescence => null, topology => null}}),
    Process = runtime_matrix_json(runtime_matrix_process_fixture(#{output_bytes => 0, output_hashed_bytes => 0,
        output_limit_bytes => 8388608, output_digest_complete => true,
        output_limit_exceeded => false, vm_process_heap_words => 33554432,
        vm_heap_includes_shared_binaries => true, crash_dumps_disabled => true,
        timed_out => false, child_exit_observed => true})),
    Report = runtime_matrix_json(#{schema => 1, status => <<"Ready">>, shareable => false,
        nonce => Nonce, deadline_ms => idw_deadline(), elapsed_ms => 3000,
        build_identity => Build, runner_sha256 => Digest, child => Child, exit_status => 0,
        process => Process, replay_command => <<"escript scripts/performance_idle_runner.escript">>,
        evidence_identity => Identity, execution_environment => Runtime}),
    Valid = fun(Value) -> idw_execution_valid(Value, Identity, Build, Digest, Metadata) end,
    true = Valid(Report),
    Mutations = [Report#{<<"private">> => <<"idle-private-marker">>},
        Report#{<<"nonce">> := binary:copy(<<"C">>, 32)},
        Report#{<<"deadline_ms">> := 60001}, Report#{<<"elapsed_ms">> := 60000},
        Report#{<<"exit_status">> := 1}, Report#{<<"runner_sha256">> := binary:copy(<<"C">>, 64)},
        Report#{<<"evidence_identity">> := Identity#{<<"files">> := 2}},
        Report#{<<"build_identity">> := Build#{<<"private">> => <<"idle-private-marker">>}},
        Report#{<<"process">> := Process#{<<"child_exit_observed">> := false}},
        Report#{<<"process">> := Process#{<<"output_sha256">> => <<"idle-private-marker">>}},
        Report#{<<"child">> := Child#{<<"private">> => <<"idle-private-marker">>}},
        Report#{<<"child">> := Child#{<<"fixture">> := Fixture#{<<"private">> => <<"idle-private-marker">>}}}],
    true = lists:all(fun(Value) -> not Valid(Value) end, Mutations),
    Observer = maps:get(<<"observer">>, Fixture),
    true = lists:all(fun(Mutation) ->
        not Valid(Report#{<<"child">> := Child#{<<"fixture">> := Fixture#{<<"observer">> := Mutation}}})
    end, [Observer#{<<"events_received">> := 7}, Observer#{<<"events_dropped">> := 1},
          Observer#{<<"invalid_events">> := 1}, Observer#{<<"event_limit">> := 4097}]),
    true = lists:all(fun(Mutation) ->
        not Valid(Report#{<<"child">> := Child#{<<"instrumentation">> := Mutation}})
    end, [Metadata#{<<"added_timers">> := 1}, Metadata#{<<"payloads_observed">> := true},
          Metadata#{<<"original_beam_sha256">> := binary:copy(<<"C">>, 64)}]),
    Failure = #{<<"exception_class">> => <<"error">>, <<"classification">> => <<"validation_failed">>,
                <<"phase">> => <<"fixture">>, <<"cause">> => <<"periodic_wakeup">>},
    Partial = Child#{<<"status">> => <<"Failed">>, <<"failure">> => Failure,
                    <<"fixture">> => Fixture#{<<"status">> => <<"Failed">>}},
    true = idw_child_valid(Partial, Nonce),
    false = Valid(Report#{<<"child">> => Partial}),
    true = lists:all(fun(Mutation) -> not idw_child_valid(Mutation, Nonce) end,
        [Partial#{<<"failure">> => Failure#{<<"cause">> => <<"idle-private-marker">>}},
         Partial#{<<"failure">> => Failure#{<<"phase">> => <<"idle-private-marker">>}},
         Partial#{<<"failure">> => Failure#{<<"raw_error">> => <<"idle-private-marker">>}},
         Partial#{<<"instrumentation">> => null},
         Partial#{<<"fixture">> => Fixture#{<<"private">> => <<"idle-private-marker">>}},
         Partial#{<<"schema">> => 1}]),
    D = maps:get(<<"diagnostics">>, Child),
    true = lists:all(fun(Mutation) -> not idw_child_valid(Partial#{<<"diagnostics">> => Mutation}, Nonce) end,
        [D#{<<"private">> => <<"idle-private-marker">>}, D#{<<"phase">> => 15},
         D#{<<"elapsed_milliseconds">> => -1},
         D#{<<"quiescence">> => #{<<"private">> => <<"idle-private-marker">>}},
         D#{<<"phases">> => [#{<<"phase">> => 0, <<"elapsed_milliseconds">> => 0},
                              #{<<"phase">> => 0, <<"elapsed_milliseconds">> => 0}]}]),
    true = try evidence_json_decode(<<"{\"nonce\":1,\"n\\u006fnce\":2}">>) of
        _ -> false catch _:_ -> true end,
    ok.

idw_fixture_test_value() ->
    Roles = [maps:merge(maps:from_list([{K, 0} || K <- idw_role_numeric_keys()]),
        #{<<"label">> => Label, <<"expected_actors">> => 1,
          <<"actors_start">> => 1, <<"actors_end">> => 1}) || Label <- idw_expected_roles()],
    runtime_matrix_json(#{schema => 2, status => <<"Ready">>, shareable => true,
        redacted => true, quiescence_confirmed => true, quiescence_maximum_attempts => 80,
        quiescence_milliseconds => 600, quiescence_poll_milliseconds => 100,
        quiescence_required_stable_samples => 5, observation_milliseconds => 2500,
        minimum_observation_milliseconds => 2500, actor_set_stable => true,
        expected_actor_count => 8, deadline_timeout_returns => 0, unexpected_actor_exits => 0,
        required_actor_liveness => true, trace_synchronized => true,
        trace_primitive => <<"gleam_erlang_ffi:select/1,2">>, roles => Roles,
        observer => #{event_limit => 4096, events_sent => 8, events_received => 8,
                      events_dropped => 0, invalid_events => 0}}).
