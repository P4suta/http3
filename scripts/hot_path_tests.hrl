-include("retained_execution_tests.hrl").
hpp_adversarial_self_test() ->
    Profile = evidence_json_decode(read(?PROFILE_PATH)), HotPath = maps:get(<<"hot_path_call_profile">>,Profile),
    Signals = maps:get(<<"signals">>,HotPath),
    Rows = [S#{<<"calls">>=>maps:get(<<"minimum_calls">>,S),<<"status">>=><<"Ready">>}||S<-Signals],
    Nonce = binary:copy(<<"B">>,32), Hash=binary:copy(<<"A">>,64),
    Identity=#{<<"source_sha256">>=>Hash}, Runtime=execution_runtime(),
    Build=#{<<"toolchain">>=>#{<<"runtime">>=>Runtime}},
    Child=runtime_matrix_json(#{schema=>1,nonce=>Nonce,status=><<"Passed">>,failure=>null,signals=>Rows}),
    Process=runtime_matrix_json(runtime_matrix_process_fixture(#{output_bytes=>0,output_hashed_bytes=>0,output_limit_bytes=>8388608,
        output_digest_complete=>true,output_limit_exceeded=>false,vm_process_heap_words=>33554432,
        vm_heap_includes_shared_binaries=>true,crash_dumps_disabled=>true,timed_out=>false,child_exit_observed=>true})),
    Execution=runtime_matrix_json(#{nonce=>Nonce,elapsed_ms=>1,deadline_ms=>120000,
        build_identity=>Build,runner_sha256=>Hash,execution_environment=>Runtime,child=>Child,exit_status=>0,process=>Process}),
    Report=runtime_matrix_json(#{schema=>2,status=><<"Ready">>,shareable=>false,
        baseline_date=>maps:get(<<"baseline_date">>,Profile),otp_release=>list_to_binary(erlang:system_info(otp_release)),
        profile_sha256=>Hash,source_sha256=>Hash,workload=>workload_report(maps:get(<<"workload">>,HotPath)),
        workload_failure=>null,execution=>Execution,replay_command=><<"escript scripts/hot_path_profile.escript">>,
        signals=>Rows,violations=>[],evidence_identity=>Identity,execution_environment=>Runtime}),
    true=hpp_report_valid(Report,Profile,HotPath,Identity,Build,Hash,Hash,Hash),
    [First|Rest]=Rows,
    BadExecutions=[Execution#{<<"nonce">>=>binary:copy(<<"C">>,32)},Execution#{<<"exit_status">>=>1},
        Execution#{<<"elapsed_ms">>=>120000},Execution#{<<"deadline_ms">>=>240000},Execution#{<<"runner_sha256">>=><<>>},
        Execution#{<<"build_identity">>=>#{}},Execution#{<<"execution_environment">>=>#{}},
        Execution#{<<"process">>=>Process#{<<"child_exit_observed">>=>false}},
        Execution#{<<"process">>=>Process#{<<"timed_out">>=>true}},
        Execution#{<<"child">>=>Child#{<<"signals">>=>Rest}},
        Execution#{<<"child">>=>Child#{<<"private">>=><<"private-hot-path-marker">>}}],
    Bads=[Report#{<<"execution">>=>E}||E<-BadExecutions]++[
        Report#{<<"private">>=><<"private-hot-path-marker">>},Report#{<<"signals">>=>Rest},
        Report#{<<"evidence_identity">>=>#{}},Report#{<<"source_sha256">>=><<>>},
        Report#{<<"signals">>=>[First#{<<"calls">>=>1 bsl 63}|Rest]},
        Report#{<<"signals">>=>[First#{<<"calls">>=>-1}|Rest]},
        Report#{<<"signals">>=>[First#{<<"private">>=><<"private-hot-path-marker">>}|Rest]}],
    lists:foreach(fun(B)->false=hpp_report_valid(B,Profile,HotPath,Identity,Build,Hash,Hash,Hash) end,Bads),
    false=hpp_execution_files_valid(Execution,[]),
    io:put_chars("hot-path evidence: source/build, count/row tampering, omitted work, exit/deadline and secrets rejected\n").

hpp_owned_self_test() ->
    Profile=evidence_json_decode(read(?PROFILE_PATH)), HotPath=maps:get(<<"hot_path_call_profile">>,Profile),
    Compiled=hpp_compile(),
    {Empty,AllCompiled}=hpp_fixture(HotPath,Compiled,"nil",30000),
    0=maps:get(exit_status,Empty),
    EmptyChild=maps:get(child,Empty), <<"Passed">>=maps:get(<<"status">>,EmptyChild),
    EmptyRows=[hpp_atom_row(R)||R<-maps:get(<<"signals">>,EmptyChild)],
    true=violations(EmptyRows)=/=[],
    false=hpp_execution_files_valid(runtime_matrix_json(Empty),Compiled),
    Retained=runtime_matrix_json(Empty),
    Directory="build/performance/hot-path-runner/"++binary_to_list(maps:get(nonce,Empty)),
    retained_execution_self_test(fun()->hpp_execution_files_valid(Retained,AllCompiled) end,
        [filename:join(Directory,"child.json")|[filename:join(Directory,atom_to_list(M)++".beam")||{M,_}<-AllCompiled]]),
    {Private,_}=hpp_fixture(HotPath,Compiled,"erlang:error({badmatch,<<\"private-hot-path-marker\">>})",30000),
    1=maps:get(exit_status,Private), true=maps:get(child_exit_observed,maps:get(process,Private)),
    true=binary:match(iolist_to_binary(json:encode(Private)),<<"private-hot-path-marker">>)=:=nomatch,
    {Resource,_}=hpp_fixture(HotPath,Compiled,
        "erlang:error({benchmark_cleanup_resource_limit,#{maximum_processes=>1,observed_processes=>2,maximum_ports=>0,observed_ports=>0,maximum_network_ports=>0,observed_network_ports=>0,maximum_sockets=>0,observed_sockets=>0}})",30000),
    1=maps:get(exit_status,Resource),
    ResourceFailure=maps:get(<<"failure">>,maps:get(child,Resource)),
    true=maps:get(<<"phase">>,ResourceFailure)=:=3,
    true=maps:get(<<"counters">>,ResourceFailure)=:=[1,2,0,0,0,0,0,0],
    {Stalled,_}=hpp_fixture(HotPath,Compiled,"receive never->nil end",30000),
    124=maps:get(exit_status,Stalled), true=maps:get(child_exit_observed,maps:get(process,Stalled)),
    {Flood,_}=hpp_fixture(HotPath,Compiled,
        "lists:foreach(fun(_)->io:put_chars(standard_error,binary:copy(<<\"private-hot-path-marker\">>,65536)) end,lists:seq(1,64)),nil",30000),
    125=maps:get(exit_status,Flood),true=maps:get(child_exit_observed,maps:get(process,Flood)),
    true=binary:match(iolist_to_binary(json:encode(Flood)),<<"private-hot-path-marker">>)=:=nomatch,
    io:put_chars("hot-path runner: empty workload, private failure, stalled and flooded VMs entered then exited and joined\n").
hpp_fixture(HotPath,Compiled,Body,Deadline) ->
    Nonce=hex(crypto:strong_rand_bytes(16)),
    Directory=filename:absname("build/diagnostics/hot-path-fixtures/"++binary_to_list(Nonce)),
    Source=filename:join(Directory,"http3_benchmark.erl"),Stage=filename:join(Directory,"entered"),
    ok=filelib:ensure_dir(Source),
    Text=["-module(http3_benchmark).\n-export([profile_workload/4]).\nprofile_workload(_,_,_,_)->",
        io_lib:format("ok=file:write_file(~0tp,<<1>>,[exclusive]),",[Stage]),Body,".\n"],
    ok=file:write_file(Source,Text),
    {ok,http3_benchmark,Bytes,[]}=compile:file(Source,[binary,return_errors,return_warnings]),
    AllCompiled=Compiled++[{http3_benchmark,Bytes}],
    Execution=execute_child(HotPath,AllCompiled,Nonce,Deadline),
    true=(try runtime_matrix_read(Stage,1)=:=<<1>> catch _:_ -> false end),
    {Execution,AllCompiled}.
